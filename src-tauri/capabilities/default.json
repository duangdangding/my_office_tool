{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "办公工具箱主窗口权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "updater:allow-check",
