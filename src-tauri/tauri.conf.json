{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "办公工具箱",
  "version": "0.2.0",
  "identifier": "com.office.toolbox",
  "build": {
    "beforeDevCommand": "node scripts/prepare-bundled-plugins.mjs && npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-bundled-plugins.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "办公工具箱",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "resources": {
      "../.generated/plugins/": "plugins/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/duangdangding/my_office_tool/releases/latest/download/latest.json"
      ],
      "pubkey": "ZFc1MGNuVnpkR1ZrSUdOdmJXMWxiblE2SUcxcGJtbHphV2R1SUhCMVlteHBZeUJyWlhrNklEazNNMFJDUWpaRlJrRXdRMEkzUVRFS1VsZFRhSFIzZWpaaWNuTTViRGw2TDJaVFRYRk1aakpHTjJWb05HdHhkbTkyU2t4eE1tUjRUbXBPYm5rMVZYVm9SVWh3VUhkMGFtUUs=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
